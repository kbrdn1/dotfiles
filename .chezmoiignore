# PRIVATE projects (sensitive personal data)
.claude/projects/*cv-exporter*/
.claude/projects/*personal*/
.claude/projects/*private*/

# Dependencies of the scripts that live in the source tree (statusline is a
# real bun project, tracked as source). Its own .gitignore already keeps
# node_modules out of git, but chezmoi does not read nested .gitignores — so
# without this it reports 703 phantom files and would copy 67 MB of
# dependencies into ~/.claude on the next apply.
.claude/scripts/**/node_modules/

# Le venv du renderer excalidraw : 133 Mo d'environnement Python reconstructible.
# Sans cette ligne, ajouter le skill excalidraw-diagram copie tout dans le repo.
.claude/skills/**/.venv/
.claude/skills/**/venv/
.claude/skills/**/node_modules/

# excalidraw-diagram et visual-explainer sont des clones tiers modifies en local.
# On versionne le contenu (les modifs comptent), jamais leur .git : chezmoi le
# mappe en dot_git/ et on se retrouve avec des packfiles dans le repo.
.claude/skills/**/.git/

# Binaire Go reconstructible par scripts/setup.sh (le skill le fait tout seul
# s'il est absent) — 4 Mo qui n'ont rien a faire dans un repo de dotfiles.
.claude/skills/changelog-generator/bin/

# Temporary/cache files in all projects
.claude/projects/**/node_modules/
.claude/projects/**/.git/
.claude/projects/**/.env.local
.claude/projects/**/dist/
.claude/projects/**/build/
.claude/projects/**/*.log

# ===================================================================
# Sensitive patterns (across all projects)
# ===================================================================
**/*secret*
**/*password*
**/*.pem
**/*.key
**/id_rsa*

# ===================================================================
# Config exclusions
# ===================================================================
