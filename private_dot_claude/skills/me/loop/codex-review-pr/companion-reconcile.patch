+
+// --- Self-heal helpers (reconcile): clean orphaned jobs + wedged brokers ---
+
+// A wedged broker keeps a live PID but stops advancing the active job's log
+// (it pins `activeStreamSocket` to a now-dead review client and answers every
+// new request with BROKER_BUSY). PID liveness alone can't detect that — the
+// honest progress signal is the running job's log mtime.
+function isProcessAlive(pid) {
+  if (!Number.isFinite(Number(pid))) {
+    return false;
+  }
+  try {
+    process.kill(Number(pid), 0);
+    return true;
+  } catch (error) {
+    // EPERM => the process exists but isn't ours; still "alive".
+    return error && error.code === "EPERM";
+  }
+}
+
+// Smallest age (ms) across active jobs that have written a log, or null when
+// no active job has a log yet. A fresh log on ANY active job means the broker
+// is making progress, so we never tear it down underneath a live review.
+function activeJobLogStallMs(workspaceRoot) {
+  const nowMs = Date.now();
+  let freshest = Infinity;
+  for (const job of listJobs(workspaceRoot)) {
+    if (job.status !== "running" && job.status !== "queued") {
+      continue;
+    }
+    const logFile = job.logFile;
+    if (!logFile || !fs.existsSync(logFile)) {
+      continue;
+    }
+    try {
+      const age = nowMs - fs.statSync(logFile).mtimeMs;
+      if (age < freshest) {
+        freshest = age;
+      }
+    } catch {
+      // Ignore unreadable log files.
+    }
+  }
+  return freshest === Infinity ? null : freshest;
+}
+
+function summarizeQueue(workspaceRoot) {
+  let queued = 0;
+  let running = 0;
+  for (const job of listJobs(workspaceRoot)) {
+    if (job.status === "queued") {
+      queued += 1;
+    } else if (job.status === "running") {
+      running += 1;
+    }
+  }
+  return { queued, running };
 }
 
+// Mark active jobs whose owning process is gone as failed, and tear down a
+// broker that is dead, explicitly forced, or stalled past `stallMs`. Always
+// safe to call: it only touches jobs with a dead PID and only restarts a
+// broker that is not making progress, so a concurrent, advancing review on
+// the same workspace is left untouched.
+async function reconcileWorkspace(workspaceRoot, options = {}) {
+  const { force = false, stallMs = null } = options;
+  const reconciledJobs = [];
+  for (const job of listJobs(workspaceRoot)) {
+    if ((job.status === "running" || job.status === "queued") && !isProcessAlive(job.pid)) {
+      upsertJob(workspaceRoot, {
+        id: job.id,
+        status: "failed",
+        phase: "aborted",
+        updatedAt: nowIso()
+      });
+      reconciledJobs.push({ id: job.id, pid: job.pid ?? null, was: job.status });
+    }
+  }
+
+  let brokerReset = false;
+  let stalledMs = null;
+  const session = loadBrokerSession(workspaceRoot);
+  if (session) {
+    const pidAlive = isProcessAlive(session.pid);
+    stalledMs = activeJobLogStallMs(workspaceRoot);
+    const stalled = Number.isFinite(stallMs) && stalledMs != null && stalledMs >= stallMs;
+    if (!pidAlive || force || stalled) {
+      // Try a graceful shutdown first so the app-server flushes; then force
+      // the teardown (kill + remove sock/pidfile/sessionDir) and drop the
+      // broker.json so the next review spawns a clean broker.
+      if (session.endpoint) {
+        try {
+          await sendBrokerShutdown(session.endpoint);
+          await waitForBrokerEndpoint(session.endpoint, 200).catch(() => false);
+        } catch {
+          // Ignore: the broker may already be gone or unresponsive.
+        }
+      }
+      teardownBrokerSession({ ...session, killProcess: terminateProcessTree });
+      clearBrokerSession(workspaceRoot);
+      brokerReset = true;
+    }
+  }
+
+  return { workspaceRoot, reconciledJobs, brokerReset, stalledMs };
+}
