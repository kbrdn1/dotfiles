#!/usr/bin/env bash
# secret : pose, copie et vérifie un secret sans que sa valeur passe jamais par stdout, stderr, argv
# (visible dans `ps`) ni un fichier lisible par d'autres. La valeur va de la source à la destination
# par un pipe, ou par une variable du script le temps du transfert : `printf` est un builtin, il ne
# crée pas de process, donc pas d'argv. Pas de heredoc ni de `<<<` pour la valeur (bash 3.2 les
# passe par un fichier de $TMPDIR). Skill : ~/.claude/skills/me/creds/SKILL.md (/me:secret).
#
#   secret set    NAME --from <source> --to <dest>[,<dest>…]   (copy = alias, --to répétable)
#   secret verify NAME --from <source> --against <dest>        → match | mismatch | unverifiable (…)
#   secret names  [--env <fichier>]                            → les noms d'un .env, jamais les valeurs
#
# Sources : prompt · gen[:hex:N|:hexN|:b64:N] · ssh:<alias>:<chemin>[:<filtre local>] · keychain
#           file:<chemin> · cmd:<commande locale> · env[:<chemin>] · ssh-env:<alias>:<chemin>
# Dest.   : env[:<chemin>] · gh[:<owner/repo>][@<environnement>] · ssh:<alias>:<chemin>
#           ssh-env:<alias>:<chemin> · keychain · age:<destinataire|fichier de destinataires>:<sortie>
#
# La valeur est lue sans ses fins de ligne finales. Une valeur sur plusieurs lignes (clé PEM) repart
# avec une fin de ligne (OpenSSH refuse une clé sans) ; une valeur d'une ligne repart sans, sauf dans
# un fichier (ssh:) où elle en prend une. Les .env (local et distant) et le Trousseau n'acceptent
# qu'une ligne. SECRET_KEYCHAIN cible un trousseau précis (défaut : celui de la session).
#
# Check : bash ~/.claude/scripts/secret.test.sh
set +x
set -euo pipefail
umask 077

NL='
'
die() { printf 'secret: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '8,10p;12,15p' "$0" | sed 's/^# \{0,1\}//'; }
# q <s> : s entre apostrophes, pour la ligne de commande d'un shell distant (sh, dash, bash)
q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
rssh() { local host=$1; shift; ssh -o BatchMode=yes -- "$host" "$@"; }

# NAME=… dans un .env : la valeur arrive en première entrée (stdin), le fichier en seconde.
# Remplace la première ligne NAME= (garde un `export ` devant), retire les doublons, ajoute à la fin sinon.
AWK_SET='NR == FNR { v = $0; next }
{ l = $0; p = ""; if (index(l, "export ") == 1) { p = "export "; l = substr(l, 8) }
  if (index(l, n "=") == 1) { if (!done) print p n "=" v; done = 1; next }
  print }
END { if (!done) print n "=" v }'
# La valeur de NAME (sans guillemets englobants), sortie 3 si absente.
AWK_GET='{ l = $0; if (index(l, "export ") == 1) l = substr(l, 8)
  if (index(l, n "=") == 1) { v = substr(l, length(n) + 2); f = substr(v, 1, 1)
    if (length(v) >= 2 && (f == "\"" || f == sq) && substr(v, length(v), 1) == f) v = substr(v, 2, length(v) - 2)
    printf "%s", v; found = 1; exit } }
END { if (!found) exit 3 }'
AWK_NAMES='{ l = $0; sub(/^[ \t]+/, "", l); if (index(l, "export ") == 1) l = substr(l, 8) }
l ~ /^[A-Za-z_][A-Za-z0-9_]*=/ { print substr(l, 1, index(l, "=") - 1) }'

# --- sources : la valeur sur stdout, qui est toujours capturée par $(…), jamais un terminal ---------
read_src() {
  local spec=$1 rest host path filter n kc=()
  [ -n "${SECRET_KEYCHAIN:-}" ] && kc=("$SECRET_KEYCHAIN")
  case $spec in
    prompt)
      osascript -e "text returned of (display dialog \"Valeur de $NAME\" default answer \"\" with hidden answer with title \"secret\" giving up after 540)" 2>/dev/null \
        || die "$NAME : saisie annulée, rien n'est écrit" ;;
    gen) openssl rand -hex 32 ;;
    gen:hex:* | gen:hex[0-9]* | gen:b64:*)
      n=${spec##*[:x]}
      case $n in '' | *[!0-9]*) die "taille invalide : $spec" ;; esac
      [ "$n" -ge 1 ] && [ "$n" -le 1024 ] || die "taille hors de 1..1024 : $spec"
      case $spec in gen:b64:*) openssl rand "$n" | openssl base64 -A ;; *) openssl rand -hex "$n" ;; esac ;;
    ssh:*:*)
      rest=${spec#ssh:}; host=${rest%%:*}; rest=${rest#*:}
      path=${rest%%:*}; filter=""; [ "$path" = "$rest" ] || filter=${rest#*:}
      if [ -n "$filter" ]; then rssh "$host" "cat -- $(q "$path")" | sh -c "$filter"
      else rssh "$host" "cat -- $(q "$path")"; fi ;;
    keychain) security find-generic-password -s "secret/$NAME" -w ${kc[@]+"${kc[@]}"} 2>/dev/null \
      || die "$NAME : absent du Trousseau (service secret/$NAME)" ;;
    file:*) path=${spec#file:}; [ -r "$path" ] || die "fichier illisible : $path"; cat -- "$path" ;;
    cmd:*) sh -c "${spec#cmd:}" ;; # la sortie d'une commande locale (ssh-keyscan filtré, un CLI de coffre)
    env | env:*)
      path=${spec#env}; path=${path#:}; path=${path:-.env}
      [ -r "$path" ] || die "fichier illisible : $path"
      awk -v n="$NAME" -v sq="'" "$AWK_GET" "$path" || die "$NAME absent de $path" ;;
    ssh-env:*:*)
      rest=${spec#ssh-env:}; host=${rest%%:*}; path=${rest#*:}
      rssh "$host" "awk -v n=$(q "$NAME") -v sq=$(q "'") $(q "$AWK_GET") $(q "$path")" || die "$NAME absent de $host:$path" ;;
    gh | gh:* | gh@*) die "un secret GitHub ne se relit pas : il ne peut pas servir de source" ;;
    *) die "source inconnue : $spec" ;;
  esac
}

# --- destinations : la valeur est dans V, envoyée par printf (builtin) dans un pipe ------------------
check_dest() {
  case $1 in
    env | env:* | gh | gh:* | gh@* | ssh:*:* | ssh-env:*:* | keychain | age:*:*) ;;
    *) die "destination inconnue : $1" ;;
  esac
}
payload() { case $V in *"$NL"*) printf '%s\n' "$V" ;; *) printf '%s' "$V" ;; esac; }
one_line() { case $V in *"$NL"*) die "$NAME : valeur sur plusieurs lignes, refusée pour $1" ;; esac; }

TMPF=""
trap '[ -z "$TMPF" ] || rm -f "$TMPF"' EXIT

write_dest() {
  local spec=$1 rest host path repo envn src mode rcpt out e kc="" args
  case $spec in
    env | env:*)
      one_line "$spec"
      path=${spec#env}; path=${path#:}; path=${path:-.env}
      [ -L "$path" ] && path=$(realpath "$path") # un .env lié (gwm link) reste lié
      src=$path; [ -e "$path" ] || src=/dev/null
      TMPF=$(mktemp "$path.XXXXXX")
      printf '%s\n' "$V" | awk -v n="$NAME" "$AWK_SET" - "$src" > "$TMPF"
      if [ "$src" != /dev/null ]; then
        mode=$(/usr/bin/stat -f %Lp "$path" 2>/dev/null || stat -c %a "$path")
        chmod "$mode" "$TMPF"
      fi
      mv -f "$TMPF" "$path"; TMPF="" ;;
    gh | gh:* | gh@*)
      rest=${spec#gh}; envn=""
      case $rest in *@*) envn=${rest##*@}; rest=${rest%@*} ;; esac
      repo=${rest#:}
      args=(secret set "$NAME")
      [ -z "$repo" ] || args+=(--repo "$repo")
      [ -z "$envn" ] || args+=(--env "$envn")
      payload | gh "${args[@]}" > /dev/null ;;
    ssh:*:*)
      rest=${spec#ssh:}; host=${rest%%:*}; path=${rest#*:}
      printf '%s\n' "$V" | rssh "$host" "set -e; umask 077; f=$(q "$path"); t=\$(mktemp \"\$f.XXXXXX\"); trap 'rm -f \"\$t\"' EXIT; cat > \"\$t\"; mv -f \"\$t\" \"\$f\"; trap - EXIT" ;;
    ssh-env:*:*)
      one_line "$spec"
      rest=${spec#ssh-env:}; host=${rest%%:*}; path=${rest#*:}
      printf '%s\n' "$V" | rssh "$host" "set -e; umask 077; f=$(q "$path"); [ ! -L \"\$f\" ] || f=\$(readlink -f \"\$f\"); s=\$f; [ -e \"\$f\" ] || s=/dev/null; t=\$(mktemp \"\$f.XXXXXX\"); trap 'rm -f \"\$t\"' EXIT; awk -v n=$(q "$NAME") $(q "$AWK_SET") - \"\$s\" > \"\$t\"; if [ \"\$s\" != /dev/null ]; then chmod --reference=\"\$f\" \"\$t\" 2>/dev/null || chmod \"\$(/usr/bin/stat -f %Lp \"\$f\")\" \"\$t\"; chown --reference=\"\$f\" \"\$t\" 2>/dev/null || true; fi; mv -f \"\$t\" \"\$f\"; trap - EXIT" ;;
    keychain)
      # `add-generic-password -w VALEUR` mettrait la valeur dans argv, et `-w` en dernier (invite lue sur
      # stdin) tronque à 128 caractères : la commande passe donc par `security -i`, qui la lit sur stdin.
      # Ses deux sorties partent à /dev/null (une erreur d'analyse peut citer la ligne) et l'écriture
      # est confirmée en relisant.
      one_line "$spec"
      e=${V//\\/\\\\}; e=${e//\"/\\\"}
      [ -z "${SECRET_KEYCHAIN:-}" ] || kc=" \"$SECRET_KEYCHAIN\""
      printf 'add-generic-password -U -a "%s" -s "secret/%s" -w "%s"%s\n' "${USER:-secret}" "$NAME" "$e" "$kc" \
        | security -i > /dev/null 2>&1 || true
      [ "$(read_src keychain 2>/dev/null)" = "$V" ] || die "$NAME : écriture dans le Trousseau non confirmée" ;;
    age:*:*)
      rest=${spec#age:}; out=${rest##*:}; rcpt=${rest%:*}
      if [ -f "$rcpt" ]; then payload | age -a -R "$rcpt" -o "$out"
      else payload | age -a -r "$rcpt" -o "$out"; fi ;;
  esac
}

# --- main ---------------------------------------------------------------------------------------------
sub=${1:-}; [ $# -eq 0 ] || shift
case $sub in
  set | copy | verify)
    NAME=${1:-}; [ $# -eq 0 ] || shift
    [[ $NAME =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "nom invalide : '$NAME' (attendu [A-Za-z_][A-Za-z0-9_]*)"
    FROM="" AGAINST="" TO=""
    while [ $# -gt 0 ]; do
      case $1 in
        --from) FROM=${2:-}; shift 2 || die "--from sans valeur" ;;
        --to) TO="$TO${TO:+,}${2:-}"; shift 2 || die "--to sans valeur" ;;
        --against) AGAINST=${2:-}; shift 2 || die "--against sans valeur" ;;
        *) die "option inconnue : $1" ;;
      esac
    done
    [ -n "$FROM" ] || die "--from manquant"
    ;;
  names)
    path=.env
    case ${1:-} in --env) path=${2:-}; [ -n "$path" ] || die "--env sans fichier" ;; '') ;; *) die "option inconnue : $1" ;; esac
    [ -r "$path" ] || die "fichier illisible : $path"
    awk "$AWK_NAMES" "$path"
    exit 0 ;;
  '' | -h | --help | help) usage; exit 0 ;;
  *) die "sous-commande inconnue : $sub (set, copy, verify, names)" ;;
esac

if [ "$sub" = verify ]; then
  [ -n "$AGAINST" ] || die "--against manquant"
  case $AGAINST in
    gh | gh:* | gh@*) echo "unverifiable (github)"; exit 2 ;;
    age:*) echo "unverifiable (age)"; exit 2 ;;
  esac
  A=$(read_src "$FROM")
  B=$(read_src "$AGAINST")
  if [ "$A" = "$B" ]; then echo match; else echo mismatch; exit 1; fi
  exit 0
fi

[ -n "$TO" ] || die "--to manquant"
IFS=, read -r -a DESTS <<< "$TO" # les specs de destination, pas la valeur
for d in "${DESTS[@]}"; do check_dest "$d"; done # rien n'est lu tant qu'une destination est invalide
V=$(read_src "$FROM")
[ -n "$V" ] || die "$NAME : valeur vide, rien n'est écrit"
for d in "${DESTS[@]}"; do
  write_dest "$d"
  printf '%s: set → %s (len %d)\n' "$NAME" "$d" "${#V}"
done
