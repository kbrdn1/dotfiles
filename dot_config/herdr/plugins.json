  {
    "plugin_id": "gwm",
    "name": "gwm worktrees",
    "version": "0.2.0",
    "min_herdr_version": "0.7.4",
    "description": "Drive gwm for git worktree management from herdr — create, switch, remove, review PRs, bootstrap, exec, clean. gwm stays the source of truth; herdr adopts.",
    "manifest_path": "/Users/kbrdn1/Projects/Perso/herdr-plugin-gwm/herdr-plugin.toml",
    "plugin_root": "/Users/kbrdn1/Projects/Perso/herdr-plugin-gwm",
    "enabled": true,
    "platforms": [
      "macos",
      "linux"
    ],
    "actions": [
      {
        "id": "clean",
        "title": "gwm: clean build artifacts",
        "contexts": [
          "workspace",
          "global"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint cleaner --placement split --direction down --cwd \"${cwd:-$PWD}\" --focus"
        ]
      },
      {
        "id": "create",
        "title": "gwm: create worktree",
        "contexts": [
          "workspace",
          "global"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint creator --placement split --direction down --cwd \"${cwd:-$PWD}\" --focus"
        ]
      },
      {
        "id": "dashboard",
        "title": "gwm: dashboard (TUI)",
        "contexts": [
          "workspace",
          "global"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint dashboard --placement zoomed --cwd \"${cwd:-$PWD}\" --focus"
        ]
      },
      {
        "id": "exec",
        "title": "gwm: exec across worktrees",
        "contexts": [
          "workspace",
          "global"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint executor --placement split --direction down --cwd \"${cwd:-$PWD}\" --focus"
        ]
      },
      {
        "id": "remove",
        "title": "gwm: remove worktree",
        "contexts": [
          "workspace"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint remover --cwd \"${cwd:-$PWD}\" --focus"
        ]
      },
      {
        "id": "review",
        "title": "gwm: review a PR",
        "contexts": [
          "workspace",
          "global"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); url=$(jq -r '.clicked_url // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint reviewer --placement split --direction down --cwd \"${cwd:-$PWD}\" --env \"GWM_REVIEW_URL=$url\" --focus"
        ]
      },
      {
        "id": "switch",
        "title": "gwm: switch worktree",
        "contexts": [
          "workspace",
          "global"
        ],
        "command": [
          "bash",
          "-c",
          "cwd=$(jq -r '.workspace_cwd // .focused_pane_cwd // empty' <<<\"$HERDR_PLUGIN_CONTEXT_JSON\"); exec \"$HERDR_BIN_PATH\" plugin pane open --plugin \"$HERDR_PLUGIN_ID\" --entrypoint picker --cwd \"${cwd:-$PWD}\" --focus"
        ]
      }
    ],
    "events": [
      {
        "on": "worktree.created",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/on_worktree_created.sh\""
        ]
      }
    ],
    "panes": [
      {
        "id": "cleaner",
        "title": "gwm — clean",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/clean.sh\""
        ]
      },
      {
        "id": "creator",
        "title": "gwm — create",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/create.sh\""
        ]
      },
      {
        "id": "dashboard",
        "title": "gwm — dashboard",
        "placement": "zoomed",
        "command": [
          "bash",
          "-c",
          "exec gwm"
        ]
      },
      {
        "id": "executor",
        "title": "gwm — exec",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/exec.sh\""
        ]
      },
      {
        "id": "picker",
        "title": "gwm — switch",
        "placement": "popup",
        "width": "70%",
        "height": "60%",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/switch.sh\""
        ]
      },
      {
        "id": "remover",
        "title": "gwm — remove",
        "placement": "popup",
        "width": "70%",
        "height": "60%",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/remove.sh\""
        ]
      },
      {
        "id": "reviewer",
        "title": "gwm — review PR",
        "placement": "split",
        "command": [
          "bash",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/bin/review.sh\""
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "github-pr",
        "title": "gwm: review this PR",
        "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$",
        "action": "review"
      }
    ],
    "source": {
      "kind": "local"
    }
  },
