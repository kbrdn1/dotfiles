          "sh",
          "-c",
          "\"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" configure --apply && herdr server reload-config && exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" startup --provider all"
        ]
      },
      {
        "id": "open-settings",
        "title": "Open agent quota settings",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_BIN_PATH\" plugin pane open --plugin herdr-agent-quota --entrypoint settings --focus"
        ]
      },
      {
        "id": "refresh",
        "title": "Refresh agent quota",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" refresh --provider all --force"
        ]
      },
      {
        "id": "uninstall",
        "title": "Uninstall agent quota configuration",
        "command": [
          "sh",
          "-c",
          "\"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" configure --uninstall && herdr server reload-config"
        ]
      }
    ],
    "events": [
      {
        "on": "pane.agent_detected",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" event"
        ]
      },
      {
        "on": "pane.agent_status_changed",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" event"
        ]
      },
      {
        "on": "pane.focused",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" focus"
        ]
      }
    ],
    "panes": [
      {
        "id": "dashboard",
        "title": "Agent quota",
        "placement": "popup",
        "command": [
          "sh",
          "-c",
          "exec \"$HERDR_PLUGIN_ROOT/target/release/herdr-agent-quota\" dashboard"
        ]
      },
      {
        "id": "settings",
        "title": "Agent quota settings",
        "placement": "popup",
        "width": 78,
