{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [18, 24],
  "theme": { "light": "kbrdn-light", "dark": "kbrdn-dark" },
  "font": "OperatorMonoLig Nerd Font",
  "font_weight": 400,
  "ui_font": "Inter",
  "toast": "kbrdn-toast",
  "terminal_menu": "kt-menu",
  "terminal_padding": [14, 12],
  "background": "chrome",
  "preview": "layouts/kbrdn-threads.png",
  "resizable": true,
  "divider": { "width": 1, "color": "border" },
  "children": [
    {
      "id": "side",
      "type": "column",
      "size": { "px": 300 },
      "min": 220,
      "max": 460,
      "background": "chrome",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": { "px": 62 },
          "window_drag": true,
          "content": { "mod": "kt-head", "props": { "part": "brand" } }
        },
        { "id": "threads", "type": "block", "content": { "mod": "kt-threads" } }
      ]
    },
    {
      "id": "desk",
      "type": "row",
      "background": { "image": "brand/dither-k.png", "fit": "cover" },
      "padding": 8,
      "gap": 8,
      "children": [
        {
          "id": "center",
          "type": "column",
          "background": "chrome",
          "border": { "width": 1, "color": "border" },
          "radius": 20,
          "shadow": "md",
          "padding": 4,
          "gap": 4,
          "children": [
            {
              "id": "crumbs",
              "type": "block",
              "size": { "px": 36 },
              "window_drag": true,
              "content": { "mod": "kt-head", "props": { "part": "crumbs" } }
            },
            {
              "id": "view",
              "type": "stack",
              "active": "thread",
              "children": [
                {
                  "id": "thread",
                  "type": "column",
                  "gap": 4,
                  "children": [
                    {
                      "id": "thread-body",
                      "type": "stack",
                      "active": "main",
                      "floating": [{ "id": "details", "content": { "mod": "kt-details" }, "edge": "right", "align": "start" }],
                      "children": [
                        {
                          "id": "main",
                          "type": "block",
                          "content": {
                            "tab": "active",
                            "pane": {
                              "background": "background",
                              "border": { "width": 1, "color": "border" },
                              "focus": { "width": 1, "color": "accent" },
                              "radius": 16,
                              "gap": 4,
                              "lone": true
                            }
                          }
                        },
                        { "id": "chat", "type": "block", "content": { "mod": "kt-chat" } }
                      ]
                    },
                    {
                      "id": "composer",
                      "type": "block",
                      "size": { "px": 36 },
                      "content": { "mod": "kt-composer" }
                    }
                  ]
                },
                { "id": "hub", "type": "block", "content": { "mod": "kt-hub" } },
                { "id": "inbox", "type": "block", "content": { "mod": "kt-inbox" } },
                { "id": "kanban", "type": "block", "content": { "mod": "kt-kanban" } },
                { "id": "workflow", "type": "block", "content": { "mod": "kt-workflow" } },
                { "id": "skills", "type": "block", "content": { "mod": "kt-skills" } },
                { "id": "mcp", "type": "block", "content": { "mod": "kt-mcp" } },
                { "id": "plugins", "type": "block", "content": { "mod": "kt-plugins" } },
                { "id": "automation", "type": "block", "content": { "mod": "kt-automation" } },
                { "id": "gwm", "type": "block", "content": { "mod": "kt-gwm" } },
                { "id": "notes", "type": "block", "content": { "mod": "kt-notes" } }
              ]
            }
          ]
        },
        {
          "id": "panel",
          "type": "column",
          "size": { "px": 560 },
          "min": 320,
          "max": 1100,
          "background": "chrome",
          "border": { "width": 1, "color": "border" },
          "radius": 20,
          "shadow": "md",
          "padding": 4,
          "gap": 4,
          "children": [
            {
              "id": "panel-head",
              "type": "block",
              "size": { "px": 36 },
              "window_drag": true,
              "content": { "mod": "kt-panel-head" }
            },
            {
              "id": "panel-body",
              "type": "stack",
              "active": "files",
              "children": [
                { "id": "files", "type": "block", "content": { "mod": "kt-files" } },
                { "id": "diff", "type": "block", "content": { "mod": "kt-diff" } },
                { "id": "history", "type": "block", "content": { "mod": "kt-history" } },
                { "id": "flow", "type": "block", "content": { "mod": "kt-flow" } },
                { "id": "crosstalk", "type": "block", "content": { "mod": "kt-crosstalk" } },
                { "id": "gwm-panel", "type": "block", "content": { "mod": "kt-gwm", "props": { "view": "panel" } } }
              ]
            }
          ]
        }
      ]
    }
  ]
}
